#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# WATCHTOWER
# Character-driven Hyprland desktop environment
# ============================================================

WT_VERSION_FILE="${WATCHTOWER_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/VERSION"
WT_ROOT="${WATCHTOWER_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"
WT_THEMES_DIR="$WT_ROOT/themes"

WT_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/watchtower"
WT_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/watchtower"
WT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/watchtower"
WT_LOG_DIR="$WT_STATE_DIR/logs"
WT_ACTIVE_THEME="$WT_STATE_DIR/active-theme"
WT_LOG_FILE="$WT_LOG_DIR/watchtower.log"

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

log() {
    local level="$1"
    shift

    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

    mkdir -p "$WT_LOG_DIR"

    printf '[%s] [%s] %s\n' \
        "$timestamp" "$level" "$*" >> "$WT_LOG_FILE"
}

info() {
    printf '\033[1;34m[INFO]\033[0m %s\n' "$*"
    log INFO "$*"
}

success() {
    printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"
    log SUCCESS "$*"
}

warning() {
    printf '\033[1;33m[WARN]\033[0m %s\n' "$*"
    log WARN "$*"
}

error() {
    printf '\033[1;31m[FAIL]\033[0m %s\n' "$*" >&2
    log ERROR "$*"
}

# ------------------------------------------------------------
# Utilities
# ------------------------------------------------------------

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

get_version() {
    if [[ -f "$WT_VERSION_FILE" ]]; then
        tr -d '[:space:]' < "$WT_VERSION_FILE"
    else
        printf 'unknown'
    fi
}

get_distro() {
    if [[ -r /etc/os-release ]]; then
        . /etc/os-release
        printf '%s' "${PRETTY_NAME:-${ID:-unknown}}"
    else
        printf 'unknown'
    fi
}

get_gpu() {
    if command_exists lspci; then
        lspci -nn 2>/dev/null |
            grep -iE 'VGA compatible controller|3D controller|Display controller' |
            sed 's/^[^:]*: //' |
            paste -sd '; ' - || true
    else
        printf 'lspci unavailable'
    fi
}

get_active_theme() {
    if [[ -f "$WT_ACTIVE_THEME" ]]; then
        cat "$WT_ACTIVE_THEME"
    else
        printf 'none'
    fi
}

# ------------------------------------------------------------
# Help and version
# ------------------------------------------------------------

show_banner() {
    printf '\n'
    printf '\033[1;34m'
    printf '  ╦ ╦╔═╗╔╦╗╔═╗╦ ╦╔╦╗╔═╗╦═╗\n'
    printf '  ╚╦╝╠═╣ ║ ║  ║ ║║║║║╣ ╠╦╝\n'
    printf '   ╩ ╩ ╩ ╩ ╚═╝╚═╝╩ ╩╚═╝╩╚═\n'
    printf '\033[0m'
    printf '  The League starts here.\n\n'
}

show_help() {
    show_banner

    cat <<'HELP'
Usage:
  watchtower <command> [subcommand] [options]

General commands:
  help                  Show this help
  version               Show project version
  status                Show environment status
  doctor                Run system diagnostics
  logs                  Display application logs

Theme commands:
  theme list            List available themes
  theme current         Show currently active theme

Examples:
  watchtower status
  watchtower doctor
  watchtower theme list
  watchtower theme current

Environment:
  WATCHTOWER_ROOT       Override project installation path
HELP
}

show_version() {
    printf 'Watchtower %s\n' "$(get_version)"
}

# ------------------------------------------------------------
# Status
# ------------------------------------------------------------

show_status() {
    show_banner

    printf 'Project\n'
    printf '  Version:       %s\n' "$(get_version)"
    printf '  Root:          %s\n' "$WT_ROOT"
    printf '  Active theme:  %s\n' "$(get_active_theme)"

    printf '\nSystem\n'
    printf '  Distribution:  %s\n' "$(get_distro)"
    printf '  Kernel:        %s\n' "$(uname -r)"
    printf '  Architecture:  %s\n' "$(uname -m)"

    printf '\nDesktop\n'

    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        success "Hyprland session detected"
    else
        warning "Hyprland session not detected"
    fi

    if command_exists quickshell; then
        success "Quickshell installed"
    else
        warning "Quickshell not installed"
    fi

    if command_exists git; then
        success "Git available"
    fi
}

# ------------------------------------------------------------
# Theme management
# ------------------------------------------------------------

theme_list() {
    printf '\nAvailable Watchtower themes\n\n'

    local found=0
    local theme_dir
    local theme_name
    local active

    active="$(get_active_theme)"

    if [[ ! -d "$WT_THEMES_DIR" ]]; then
        warning "Theme directory not found: $WT_THEMES_DIR"
        return 0
    fi

    for theme_dir in "$WT_THEMES_DIR"/*/; do
        [[ -d "$theme_dir" ]] || continue

        theme_name="$(basename "$theme_dir")"

        if [[ -f "$theme_dir/theme.yaml" ]]; then
            if [[ "$theme_name" == "$active" ]]; then
                printf '  \033[1;32m● %s (active)\033[0m\n' "$theme_name"
            else
                printf '  \033[1;34m○ %s\033[0m\n' "$theme_name"
            fi
            ((found+=1))
        fi
    done

    if (( found == 0 )); then
        warning "No valid theme manifests found yet."
    fi

    printf '\nTotal: %s\n' "$found"
}

theme_current() {
    local active
    active="$(get_active_theme)"

    if [[ "$active" == "none" ]]; then
        info "No character theme has been activated yet."
    else
        printf 'Active theme: %s\n' "$active"
    fi
}

theme_command() {
    local subcommand="${1:-help}"

    case "$subcommand" in
        list)
            theme_list
            ;;
        current)
            theme_current
            ;;
        help|--help|-h)
            printf 'Usage: watchtower theme {list|current}\n'
            ;;
        *)
            error "Unknown theme command: $subcommand"
            return 2
            ;;
    esac
}

# ------------------------------------------------------------
# System diagnostics
# ------------------------------------------------------------

check_item() {
    local label="$1"
    local result="$2"

    if [[ "$result" == "true" ]]; then
        success "$label"
    else
        warning "$label"
    fi
}

run_doctor() {
    show_banner

    printf 'WATCHTOWER SYSTEM DIAGNOSTICS\n\n'

    printf 'Operating system\n'

    if [[ -r /etc/os-release ]]; then
        . /etc/os-release

        printf '  Distribution: %s\n' "${PRETTY_NAME:-unknown}"

        if [[ "${ID:-}" == "arch" ||
              " ${ID_LIKE:-} " == *" arch "* ||
              "${ID:-}" == "cachyos" ]]; then
            success "Arch-compatible distribution"
        else
            warning "Distribution is outside the initial support target"
        fi
    else
        warning "Cannot identify distribution"
    fi

    printf '\nDevelopment tools\n'

    check_item "Git" "$(command_exists git && echo true || echo false)"
    check_item "Bash" "$(command_exists bash && echo true || echo false)"
    check_item "Python 3" "$(command_exists python3 && echo true || echo false)"
    check_item "Quickshell" "$(command_exists quickshell && echo true || echo false)"
    # Hyprland installation, session and IPC are separate checks.
    check_item "Hyprland binary" "$(if command_exists Hyprland || command_exists hyprland; then echo true; else echo false; fi)"
    check_item "Hyprland session" "$([[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && echo true || echo false)"
    check_item "Hyprland IPC" "$(command_exists hyprctl && hyprctl version >/dev/null 2>&1 && echo true || echo false)"
    check_item "PipeWire" "$(command_exists wpctl && echo true || echo false)"
    check_item "D-Bus" "$(command_exists busctl && echo true || echo false)"
    check_item "systemd" "$(command_exists systemctl && echo true || echo false)"
    check_item "lspci" "$(command_exists lspci && echo true || echo false)"

    printf '\nGPU detection\n'

    local gpu
    gpu="$(get_gpu)"

    if [[ -n "$gpu" ]]; then
        printf '%s\n' "$gpu"
    else
        warning "GPU information unavailable"
    fi

    if command_exists nvidia-smi; then
        success "NVIDIA management interface available"
    else
        info "NVIDIA management interface unavailable"
    fi

    printf '\nProject directories\n'

    check_item "Themes directory" "$([[ -d "$WT_THEMES_DIR" ]] && echo true || echo false)"
    check_item "Quickshell directory" "$([[ -d "$WT_ROOT/shell/quickshell" ]] && echo true || echo false)"
    check_item "Installer directory" "$([[ -d "$WT_ROOT/installer" ]] && echo true || echo false)"

    printf '\nDiagnostics complete.\n'
    log INFO "System diagnostics completed"
}

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

show_logs() {
    if [[ -f "$WT_LOG_FILE" ]]; then
        tail -n 50 "$WT_LOG_FILE"
    else
        warning "No logs available yet."
    fi
}

# ------------------------------------------------------------
# Main command dispatcher
# ------------------------------------------------------------

main() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        status)
            show_status
            ;;
        doctor)
            run_doctor
            ;;
        logs)
            show_logs
            ;;
        theme)
            theme_command "$@"
            ;;
        *)
            error "Unknown command: $command"
            printf 'Run "watchtower help" for available commands.\n' >&2
            return 2
            ;;
    esac
}

main "$@"
