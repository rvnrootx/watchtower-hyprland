{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Watchtower Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "appearance",
    "shell",
    "dynamic_island",
    "notifications",
    "control_center",
    "batcomputer",
    "sound",
    "stealth",
    "scheduler"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "color_scheme", "accent_color", "transparency", "animations", "reduce_motion"],
      "properties": {
        "character": {
          "type": "string",
          "enum": ["batman", "superman", "wonder-woman", "flash", "nightwing", "redhood"]
        },
        "color_scheme": {"type": "string", "enum": ["dark", "light", "system"]},
        "accent_color": {"type": "string", "minLength": 1, "maxLength": 40},
        "transparency": {"type": "number", "minimum": 0, "maximum": 1},
        "animations": {"type": "boolean"},
        "reduce_motion": {"type": "boolean"}
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "position", "margin", "font_family", "font_size"],
      "properties": {
        "enabled": {"type": "boolean"},
        "position": {"type": "string", "enum": ["top", "bottom"]},
        "margin": {"type": "integer", "minimum": 0, "maximum": 100},
        "font_family": {"type": "string", "minLength": 1, "maxLength": 100},
        "font_size": {"type": "integer", "minimum": 6, "maximum": 48}
      }
    },
    "dynamic_island": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "position", "collapsed_width", "expanded_width", "auto_collapse_seconds", "show_media", "show_notifications", "show_system_status"],
      "properties": {
        "enabled": {"type": "boolean"},
        "position": {"type": "string", "enum": ["top-center", "top-left", "top-right"]},
        "collapsed_width": {"type": "integer", "minimum": 80, "maximum": 600},
        "expanded_width": {"type": "integer", "minimum": 160, "maximum": 1000},
        "auto_collapse_seconds": {"type": "integer", "minimum": 0, "maximum": 120},
        "show_media": {"type": "boolean"},
        "show_notifications": {"type": "boolean"},
        "show_system_status": {"type": "boolean"}
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "position", "duration_seconds", "max_visible", "do_not_disturb"],
      "properties": {
        "enabled": {"type": "boolean"},
        "position": {"type": "string", "enum": ["top-right", "top-left", "bottom-right", "bottom-left"]},
        "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 120},
        "max_visible": {"type": "integer", "minimum": 1, "maximum": 20},
        "do_not_disturb": {"type": "boolean"}
      }
    },
    "control_center": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "show_network", "show_audio", "show_brightness", "show_battery"],
      "properties": {
        "enabled": {"type": "boolean"},
        "show_network": {"type": "boolean"},
        "show_audio": {"type": "boolean"},
        "show_brightness": {"type": "boolean"},
        "show_battery": {"type": "boolean"}
      }
    },
    "batcomputer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "refresh_interval_seconds", "show_cpu", "show_memory", "show_gpu", "show_network", "show_storage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "refresh_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "show_cpu": {"type": "boolean"},
        "show_memory": {"type": "boolean"},
        "show_gpu": {"type": "boolean"},
        "show_network": {"type": "boolean"},
        "show_storage": {"type": "boolean"}
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "character_sounds", "interface_sounds", "volume"],
      "properties": {
        "enabled": {"type": "boolean"},
        "character_sounds": {"type": "boolean"},
        "interface_sounds": {"type": "boolean"},
        "volume": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "stealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mute_interface_sounds", "disable_animations", "hide_notifications"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mute_interface_sounds": {"type": "boolean"},
        "disable_animations": {"type": "boolean"},
        "hide_notifications": {"type": "boolean"}
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "automatic_theme_switching", "day_theme", "night_theme", "day_start", "night_start"],
      "properties": {
        "enabled": {"type": "boolean"},
        "automatic_theme_switching": {"type": "boolean"},
        "day_theme": {"$ref": "#/$defs/character"},
        "night_theme": {"$ref": "#/$defs/character"},
        "day_start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "night_start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
      }
    }
  },
  "$defs": {
    "character": {
      "type": "string",
      "enum": ["batman", "superman", "wonder-woman", "flash", "nightwing", "redhood"]
    }
  }
}
