{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Watchtower Character Theme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "version",
    "palette",
    "typography",
    "shape",
    "effects",
    "animation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "foreground",
        "surface",
        "surface_alt",
        "primary",
        "secondary",
        "accent",
        "border",
        "success",
        "warning",
        "danger"
      ],
      "properties": {
        "background": {"$ref": "#/$defs/color"},
        "foreground": {"$ref": "#/$defs/color"},
        "surface": {"$ref": "#/$defs/color"},
        "surface_alt": {"$ref": "#/$defs/color"},
        "primary": {"$ref": "#/$defs/color"},
        "secondary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "border": {"$ref": "#/$defs/color"},
        "success": {"$ref": "#/$defs/color"},
        "warning": {"$ref": "#/$defs/color"},
        "danger": {"$ref": "#/$defs/color"}
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "size", "weight"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "size": {"type": "number", "minimum": 8, "maximum": 24},
        "weight": {"type": "integer", "minimum": 100, "maximum": 900}
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius", "border_width"],
      "properties": {
        "radius": {"type": "integer", "minimum": 0, "maximum": 40},
        "border_width": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transparency", "blur"],
      "properties": {
        "transparency": {"type": "number", "minimum": 0, "maximum": 1},
        "blur": {"type": "boolean"}
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "duration"],
      "properties": {
        "enabled": {"type": "boolean"},
        "duration": {"type": "integer", "minimum": 0, "maximum": 2000}
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
